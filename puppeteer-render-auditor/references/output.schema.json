{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Puppeteer JS Rendering Auditor Output",
  "type": "object",
  "required": ["status", "results"],
  "properties": {
    "status": { "enum": ["ok", "error"] },
    "audited": { "type": "integer" },
    "results": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["url"],
        "properties": {
          "url": { "type": "string" },
          "status": { "type": "integer" },
          "render_status": { "enum": ["ok", "timeout"] },
          "severity": { "enum": ["high", "medium", "none"] },
          "text_delta_words": { "type": "integer" },
          "links_added": { "type": "array", "items": { "type": "string" } },
          "links_removed": { "type": "array", "items": { "type": "string" } },
          "meta_changed": { "type": "object" },
          "jsonld_added": { "type": "integer" },
          "note": { "type": "string" },
          "error": { "type": "string" },
          "skipped": { "type": "string" }
        }
      }
    },
    "error": { "type": "object", "properties": { "code": { "type": "string" }, "message": { "type": "string" } } }
  }
}
