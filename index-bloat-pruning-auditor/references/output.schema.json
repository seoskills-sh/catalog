{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Index Bloat Pruning Auditor Output",
  "type": "object",
  "required": ["status", "summary", "results"],
  "properties": {
    "status": { "enum": ["ok", "error"] },
    "summary": {
      "type": "object",
      "required": ["indexed_urls", "prunable_urls", "projected_crawl_savings_pct", "action_distribution"],
      "properties": {
        "indexed_urls": { "type": "integer" },
        "prunable_urls": { "type": "integer" },
        "bloat_ratio": { "type": "number" },
        "projected_crawl_savings_pct": { "type": "number" },
        "action_distribution": { "type": "object", "additionalProperties": { "type": "integer" } },
        "crawl_cost_source": { "enum": ["logs", "uniform_proxy"] },
        "ga4_source": { "enum": ["api", "file", "off", "no_token"] },
        "duplicate_clusters": { "type": "integer" }
      }
    },
    "consolidation_clusters": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["title", "urls", "primary", "size"],
        "properties": {
          "title": { "type": "string" },
          "urls": { "type": "array", "items": { "type": "string" } },
          "primary": { "type": "string" },
          "size": { "type": "integer" }
        }
      }
    },
    "results": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["url", "clicks", "impressions", "value_score", "bloat_score", "action"],
        "properties": {
          "url": { "type": "string" },
          "clicks": { "type": "number" },
          "impressions": { "type": "number" },
          "position": { "type": "number" },
          "sessions": { "type": "number" },
          "engagement_rate": { "type": "number" },
          "conversions": { "type": "number" },
          "internal_links": { "type": "integer" },
          "crawl_cost": { "type": "number" },
          "value_score": { "type": "number" },
          "bloat_score": { "type": "number" },
          "action": { "enum": ["keep", "consolidate", "noindex", "remove_410", "already_gone"] },
          "consolidation_target": { "type": ["string", "null"] },
          "reasons": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "error": {
      "type": "object",
      "properties": { "code": { "type": "string" }, "message": { "type": "string" } }
    }
  }
}
