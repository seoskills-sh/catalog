{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SERP Feature Volatility Tracker Output",
  "type": "object",
  "required": ["status", "changes", "snapshots"],
  "properties": {
    "status": { "enum": ["ok", "error"] },
    "keyword_count": { "type": "integer" },
    "partial": { "type": "integer" },
    "changes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["keyword", "status"],
        "properties": {
          "keyword": { "type": "string" },
          "status": { "enum": ["ok", "baseline", "serp_error"] },
          "volatility_score": { "type": ["number", "null"] },
          "class": { "enum": ["stable", "shifting", "volatile"] },
          "rank_volatility": { "type": "number" },
          "feature_volatility": { "type": "number" },
          "features_gained": { "type": "array", "items": { "type": "string" } },
          "features_lost": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "snapshots": {
      "type": "array",
      "description": "Persist and pass back as `previous` next run.",
      "items": {
        "type": "object",
        "required": ["keyword", "ranking", "features", "captured_at"],
        "properties": {
          "keyword": { "type": "string" },
          "ranking": { "type": "array", "items": { "type": "string" } },
          "features": { "type": "object", "additionalProperties": { "type": "boolean" } },
          "captured_at": { "type": "string" }
        }
      }
    },
    "error": { "type": "object", "properties": { "code": { "type": "string" }, "message": { "type": "string" } } }
  }
}
