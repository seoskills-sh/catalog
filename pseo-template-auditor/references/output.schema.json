{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Programmatic Template Auditor Output",
  "type": "object",
  "required": ["status", "template_verdict", "pages"],
  "properties": {
    "status": { "enum": ["ok", "error"] },
    "pages_sampled": { "type": "integer" },
    "pages_analyzed": { "type": "integer" },
    "shingle_size_k": { "type": "integer" },
    "hamming_threshold": { "type": "integer" },
    "boilerplate_shingles": { "type": "integer" },
    "template_verdict": {
      "enum": ["healthy", "duplicate_heavy", "boilerplate_dominant", "thin", "doorway"]
    },
    "avg_content_uniqueness_ratio": { "type": "number" },
    "avg_unique_token_budget": { "type": "number" },
    "thin_pages": { "type": "integer" },
    "near_duplicate_pages": { "type": "integer" },
    "doorway_pages": { "type": "integer" },
    "duplicate_clusters": { "type": "array", "items": { "$ref": "#/$defs/cluster" } },
    "pages": { "type": "array", "items": { "$ref": "#/$defs/page" } },
    "unreachable": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": { "url": { "type": "string" }, "http_status": { "type": "integer" } }
      }
    },
    "error": {
      "type": "object",
      "properties": { "code": { "type": "string" }, "message": { "type": "string" } }
    }
  },
  "$defs": {
    "cluster": {
      "type": "object",
      "required": ["cluster_id", "size", "urls"],
      "properties": {
        "cluster_id": { "type": "integer" },
        "size": { "type": "integer" },
        "urls": { "type": "array", "items": { "type": "string" } },
        "max_hamming_in_cluster": { "type": "integer" }
      }
    },
    "page": {
      "type": "object",
      "required": ["url", "token_count", "simhash", "content_uniqueness_ratio", "flags"],
      "properties": {
        "url": { "type": "string" },
        "token_count": { "type": "integer" },
        "simhash": { "type": "string" },
        "unique_shingles": { "type": "integer" },
        "total_shingles": { "type": "integer" },
        "content_uniqueness_ratio": { "type": "number" },
        "unique_token_budget": { "type": "integer" },
        "near_duplicate_cluster": { "type": ["integer", "null"] },
        "gsc_clicks": { "type": ["number", "null"] },
        "flags": { "type": "array", "items": { "enum": ["thin", "near_duplicate", "doorway"] } }
      }
    }
  }
}
