{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "GA4 Attribution Path Modeler Output",
  "type": "object",
  "required": ["status", "conversion_count", "by_channel"],
  "properties": {
    "status": { "enum": ["ok", "no_conversions", "timeout", "error"] },
    "schema_variant": { "enum": ["collected_traffic_source", "event_traffic_source"] },
    "identity_basis": { "enum": ["user_id", "user_pseudo_id"] },
    "conversion_count": { "type": "integer", "minimum": 0 },
    "total_value": { "type": "number" },
    "lookback_days": { "type": "integer" },
    "unattributed_sessions": { "type": "integer" },
    "organic_assist_ratio": {
      "type": ["number", "null"],
      "description": "organic position_based credit / organic last_click credit; >1 means last-click undercounts organic"
    },
    "by_channel": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["channel", "last_click", "linear", "position_based"],
        "properties": {
          "channel": { "type": "string" },
          "last_click": { "type": "number" },
          "linear": { "type": "number" },
          "position_based": { "type": "number" }
        }
      }
    },
    "job_id": { "type": "string" },
    "error": { "type": "object", "properties": { "code": { "type": "string" }, "message": { "type": "string" } } }
  }
}
