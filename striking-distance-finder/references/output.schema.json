{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Striking Distance Opportunity Finder Output",
  "type": "object",
  "required": ["status", "site_url", "opportunities"],
  "properties": {
    "status": { "enum": ["ok", "no_opportunities", "error"] },
    "site_url": { "type": "string" },
    "date_range": { "type": "array", "items": { "type": "string" }, "minItems": 2, "maxItems": 2 },
    "band": { "type": "array", "items": { "type": "integer" }, "minItems": 2, "maxItems": 2 },
    "target_position": { "type": "integer" },
    "opportunity_count": { "type": "integer", "minimum": 0 },
    "opportunities": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["query", "url", "position", "impressions", "projected_uplift_clicks", "effort_hint"],
        "properties": {
          "query": { "type": "string" },
          "url": { "type": "string" },
          "position": { "type": "number", "minimum": 1 },
          "impressions": { "type": "integer" },
          "clicks": { "type": "integer" },
          "ctr_basis": { "enum": ["observed", "modeled"] },
          "projected_uplift_clicks": { "type": "integer", "minimum": 0 },
          "effort_hint": { "enum": ["low", "medium"] },
          "also_ranking_urls": { "type": "array", "items": { "type": "string" } },
          "gap": {
            "type": ["object", "null"],
            "properties": {
              "title_missing_term": { "type": "boolean" },
              "h1_missing_term": { "type": "boolean" }
            }
          },
          "gap_status": { "enum": ["ok", "fetch_failed", "rate_limited_host"] }
        }
      }
    },
    "error": { "type": "object", "properties": { "code": { "type": "string" }, "message": { "type": "string" } } }
  }
}
