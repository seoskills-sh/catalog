{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "On-Page Schema Coverage Auditor Output",
  "type": "object",
  "required": ["status", "results"],
  "properties": {
    "status": { "enum": ["ok", "error"] },
    "pages_audited": { "type": "integer" },
    "failing": { "type": "integer" },
    "results": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["url", "status", "detected_type", "coverage_score", "grade", "issues"],
        "properties": {
          "url": { "type": "string" },
          "status": { "const": "ok" },
          "detected_type": { "type": "string" },
          "classification_confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "recommended_types": { "type": "array", "items": { "type": "string" } },
          "present_types": { "type": "array", "items": { "type": "string" } },
          "coverage_score": { "type": "integer", "minimum": 0, "maximum": 100 },
          "grade": { "enum": ["pass", "needs_work", "fail"] },
          "lost_rich_results": { "type": "array", "items": { "type": "string" } },
          "issues": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["code"],
              "properties": {
                "code": {
                  "enum": ["SCHEMA_MISSING", "REQUIRED_PROPERTY_MISSING", "RECOMMENDED_PROPERTY_MISSING",
                           "INVALID_VALUE", "INVALID_JSONLD"]
                }
              },
              "additionalProperties": true
            }
          }
        }
      }
    },
    "unreachable": {
      "type": "array",
      "items": { "type": "object", "properties": { "url": { "type": "string" }, "http_status": { "type": "integer" } } }
    },
    "error": { "type": "object", "properties": { "code": { "type": "string" }, "message": { "type": "string" } } }
  }
}
