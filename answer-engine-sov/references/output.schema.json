{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Answer Engine Share-of-Voice Reporter Output",
  "type": "object",
  "required": ["status", "overall_sov", "leaderboard"],
  "properties": {
    "status": { "enum": ["ok", "error"] },
    "weighting": { "enum": ["mention", "citation", "first_mention"] },
    "engines": { "type": "array", "items": { "type": "string" } },
    "skipped_engines": {
      "type": "array",
      "items": { "type": "object", "properties": { "engine": { "type": "string" }, "reason": { "type": "string" } } }
    },
    "answered_cells": { "type": "integer" },
    "total_cells": { "type": "integer" },
    "per_engine_sov": {
      "type": "object",
      "additionalProperties": { "type": "object", "additionalProperties": { "type": "number" } }
    },
    "per_cluster_sov": {
      "type": "object",
      "additionalProperties": { "type": "object", "additionalProperties": { "type": "number" } }
    },
    "overall_sov": { "type": "object", "additionalProperties": { "type": "number" } },
    "leaderboard": { "type": "array", "items": { "type": "string" } },
    "self_brand": { "type": ["string", "null"] },
    "self_rank": { "type": ["integer", "null"] },
    "error": { "type": "object", "properties": { "code": { "type": "string" }, "message": { "type": "string" } } }
  }
}
